# ─────────────────────────────────────────────────────────────
# Voyage AI (Travelmate) — Environment Configuration
# Copy to `.env.local`. Every key is OPTIONAL: the app degrades
# gracefully to a high-quality mock/heuristic engine when a key
# is missing, so you can run the full UI with ZERO cost / zero keys.
# ─────────────────────────────────────────────────────────────

# ── AI Provider Layer ──
# Default provider: "gemini" (free tier) | "mock" (no key, offline)
# Future: "openai" | "claude" | "openrouter" | "deepseek"
AI_PROVIDER=gemini

# Google Gemini — free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model id (free-tier friendly default)
GEMINI_MODEL=gemini-1.5-flash

# ── Prepared for future upgrade (leave blank for the free MVP) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Supabase (free tier) — https://supabase.com ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for admin tasks (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional free location enrichment ──
# OpenTripMap — free tier: https://opentripmap.io/product
OPENTRIPMAP_API_KEY=
# Foursquare (optional) — https://foursquare.com/developers
FOURSQUARE_API_KEY=

# ── Stripe (future, disabled for MVP) ──
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# A contact email used as the User-Agent for OpenStreetMap/Nominatim (etiquette)
OSM_CONTACT_EMAIL=
