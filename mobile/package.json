{
  "name": "voyage-ai-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Voyage AI (Travelmate) — premium native AI travel concierge for Android & iOS, built with Expo + React Native.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild -p android --clean",
    "build:apk": "eas build -p android --profile preview",
    "build:play": "eas build -p android --profile production",
    "typecheck": "tsc --noEmit",
    "validate": "tsc src/lib/itinerary/dayflow.ts src/lib/itinerary/scoring.ts src/lib/itinerary/interests.ts src/lib/data/knowledge.ts src/lib/itinerary/optimize.ts --outDir .validate --rootDir src --module commonjs --target es2020 --moduleResolution node --skipLibCheck --esModuleInterop --noEmitOnError false && node scripts/validate-itinerary.cjs",
    "lint": "expo lint",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@google/generative-ai": "^0.21.0",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~52.0.27",
    "expo-asset": "~11.0.1",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "^0.13.3",
    "expo-constants": "~17.0.4",
    "expo-device": "~7.0.2",
    "expo-font": "~13.0.3",
    "expo-haptics": "~14.0.1",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.4",
    "expo-location": "~18.0.5",
    "expo-network": "~7.0.5",
    "expo-notifications": "~0.29.13",
    "expo-router": "~4.0.17",
    "expo-splash-screen": "~0.29.21",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.7",
    "lucide-react-native": "^0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
