# ─────────────────────────────────────────────────────────────
# Voyage AI Mobile — Environment Configuration
# Copy to `.env` (or `.env.local`). EVERY key is OPTIONAL: the app runs fully
# offline / key-free with on-device engines, a styled map preview and smart
# templated narration. Add keys to unlock the premium tiers.
#
# Expo exposes only vars prefixed with EXPO_PUBLIC_* to the app at runtime.
# ─────────────────────────────────────────────────────────────

# ── AI Provider Layer ──
# "gemini" (free tier, runs on-device) | "mock" (no key, offline)
EXPO_PUBLIC_AI_PROVIDER=mock
# Google Gemini — free tier: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-1.5-flash

# ── Native Maps (Android) ──
# Without this, the map shows a styled placeholder + pin list (still functional).
# Get a free key: https://console.cloud.google.com → enable "Maps SDK for Android".
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Supabase (optional cloud sync / auth) — https://supabase.com ──
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── OSM etiquette: a contact email used in the User-Agent for free OSM APIs ──
EXPO_PUBLIC_OSM_CONTACT_EMAIL=contact@voyage.ai
